# =============================================================================
# deploy/.env.prod.example — 生产环境变量模板
# =============================================================================
# 用法：
#   cp deploy/.env.prod.example deploy/.env.prod
#   然后逐项填入真实值，再执行 bash deploy/scripts/preflight.sh
#
# ⛔ 本文件**不含任何真值密钥**，所有密钥位均为空或占位符。
# ⛔ deploy/.env.prod 已被仓库根 .gitignore 的 `.env` 规则覆盖（见 .gitignore:19），
#    但请显式 `git status` 确认它没有出现在待提交列表里再 push。
#
# 生成密钥（每个都是独立的一次调用，不要复用输出）：
#   openssl rand -hex 32   # 用于 *_SECRET（64 字符）
#   openssl rand -hex 16   # 用于 *_PASSWORD（32 字符）
#
# 密钥轮换要求：2026-08-24 曾有示例密码进过版本库（见 runbook-deploy §5）。
# 本模板中若出现与历史泄漏值相同的字符串，preflight.sh 会直接拒绝部署。
# =============================================================================


# ── 部署标识 ─────────────────────────────────────────────────────────────────
# 要部署的镜像 tag。**禁止 latest**：latest 指向可变引用，回滚时无法确定
# "上一个版本"到底是哪个，回滚能力直接失效。推荐用 commit SHA（sha-<hash>）
# 或语义化版本（0.2.0），两者都由 CI 的 docker-publish 产出。
CORPS_IMAGE_TAG=

# 当前已部署版本（deploy.sh 成功后自动写入 deploy/VERSION，勿手工改）
# CORPS_CURRENT_VERSION=


# ── 对外地址 ─────────────────────────────────────────────────────────────────
# 备案完成后：填域名，如 corps.example.com（Caddy 自动签发并续期 HTTPS）
# 备案期内：填 http://<服务器公网IP>（显式 http:// 前缀会关闭自动 HTTPS；
#           未备案域名解析到境内 IP 会被运营商拦截，这是唯一合法访问方式）
CORPS_SITE_ADDRESS=
# ACME 注册邮箱：Let's Encrypt 的到期与账户通知入口。留空收不到任何提醒。
ACME_EMAIL=


# ── 数据库 ───────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=corps
# openssl rand -hex 16
POSTGRES_PASSWORD=
# RLS 加固模式的运行时最小权限角色密码。RLS_ACTIVATE=true 时必填，
# 且必须与 db/rls-activate.sql 创建角色时传入的值一致（entrypoint 负责）。
# openssl rand -hex 16
CORPS_APP_PASSWORD=
# 生产必须 true：false 等于关掉引擎层租户隔离，所有表对 corps_app 开放。
RLS_ACTIVATE=true
# 统一写策略：enforce（默认拒）/ shadow（只记日志）/ off。生产用 enforce。
WRITE_POLICY_MODE=enforce


# ── 认证密钥（三个都必须 ≥32 字符，否则 web/lib/env.ts 启动即 exit 1）─────────
# openssl rand -hex 32
JWT_ACCESS_SECRET=
# openssl rand -hex 32
JWT_REFRESH_SECRET=
# openssl rand -hex 32
BETTER_AUTH_SECRET=


# ── 运行时 ───────────────────────────────────────────────────────────────────
# 容器内访问 app 用服务名，不要写 localhost
REDIS_URL=redis://redis:6379
# Redis 内存上限（compose 传给 redis-server --maxmemory）。
# 2C4G 机器上 128mb 足够：限流计数键很小，且带 PEXPIRE 自动过期。
REDIS_MAXMEMORY=128mb
LOG_LEVEL=info
# 生产应为 https://（middleware 的 HSTS 与 secure cookie 依赖它）。
# 备案期用 http://<IP> 时可与 CORPS_SITE_ADDRESS 保持一致。
NEXT_PUBLIC_APP_URL=
# 定时作业 Bearer 鉴权：cron 容器调用 /api/cron/* 时携带，app 侧同一把钥匙。
# openssl rand -hex 32
CRON_SECRET=
# 调度时区。北京时间填 Asia/Shanghai（UTC 时提醒与周报会差 8 小时）
CRON_TZ=Asia/Shanghai


# ── 反向代理 ─────────────────────────────────────────────────────────────────
CADDY_VERSION=2.10.2
CADDY_LOG_LEVEL=INFO
# 请求体上限：IM 附件走 /api/uploads，默认值 25MB
REQUEST_MAX_SIZE=25MB
# ── 启用 LiveKit（音视频）时才需要 ───────────────────────────────────────────
# ⛔ 这两项虽标为可选，但根 docker-compose.yml 用 `${LIVEKIT_API_KEY:?...}` 声明，
#    意味着 **compose 渲染阶段就要求它们非空**——不填，整个 `docker compose` 命令
#    （含 config / ps / logs）都会直接报错退出。overlay 无法解除该约束：
#    Compose 对每个文件先插值再合并，overlay 写 `:-` 覆盖不生效（已实测）。
#    所以：不用音视频也必须给值。为避免"看起来像真配置"，此处用显眼的占位值，
#    preflight.sh 会检测到它们并提示 LiveKit 未启用（不影响部署通过）。
#    换成真值（openssl rand -hex 24）后，CORPS_LIVEKIT_SITE_ADDRESS 也要一并填。
LIVEKIT_API_KEY=UNUSED_LIVEKIT_DISABLED
LIVEKIT_API_SECRET=UNUSED_LIVEKIT_DISABLED
# 启用时的站点地址（如 livekit.example.com）；未启用保持为空，Caddy 跳过该站点
CORPS_LIVEKIT_SITE_ADDRESS=
LIVEKIT_UPSTREAM=livekit:7880
# LiveKit 媒体端口：TCP 7881 + UDP 50000-50100。
# ⚠️ 这两个端口不经 Caddy，必须在云厂商安全组同时放通，否则通话只有信令没有媒体。
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_START=50000
LIVEKIT_RTC_UDP_END=50100


# ── 备份 ─────────────────────────────────────────────────────────────────────
# 备份目录（宿主机路径）。deploy.sh 每次上线前会先触发一次备份到这里。
# 必须是**宿主机**路径——容器内路径在 compose 里看不到。
BACKUP_DIR=/opt/corps/backups
# 保留天数。7 天 = 最多丢失 7 天数据（逻辑备份 RPO，见 README §7）
RETENTION_DAYS=7
# 恢复演练用的临时库名（restore.sh --dry-run 使用，绝不碰生产库）
RESTORE_CHECK_DB=corps_restore_check


# ── 可选：业务功能开关（留空即不启用，对应功能在 UI 隐藏入口）──────────────
# 计费
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_YEARLY=
# 国内支付
PAYMENT_PROVIDER=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
# 邮件
RESEND_API_KEY=
EMAIL_FROM=
# 日历集成
CALENDAR_CRYPTO_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# 对象存储（IM 附件；未配置时回退本地上传卷，重建容器不丢但换机需手动搬）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# 错误上报（Sentry 走 Envelope HTTP API；未配置时仅本地结构化日志）
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 告警 webhook（飞书/企业微信/Slack 自定义机器人）
ERROR_WEBHOOK_URL=
# Prometheus 端点令牌：设置后 /api/metrics 要求 Bearer。
# 注意 Caddy 已在反代层对该路径返回 403，公网无论如何都拿不到。
METRICS_TOKEN=
# 跨源白名单（逗号分隔精确 Origin）。单域名部署通常留空。
CORS_ORIGINS=
# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
