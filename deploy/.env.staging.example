# Staging 变量模板：只含空密钥，不含任何真实凭据。
# cp deploy/.env.staging.example deploy/.env.staging 后逐项填入真实值。

# 应用与数据库
POSTGRES_USER=postgres
POSTGRES_DB=corps_staging
POSTGRES_PASSWORD=
CORPS_APP_PASSWORD=
RLS_ACTIVATE=true
WRITE_POLICY_MODE=enforce
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
APP_PORT=3000
REDIS_URL=redis://redis:6379
RATE_LIMIT_DISABLED=

# 认证与 cron（各自独立随机值，不复用）
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
BETTER_AUTH_SECRET=
CRON_SECRET=

# sidecar：源码 checkout 位置、固定数据目录与 Admin key
NEXUSLOOM_CONTEXT=../Workflow/nexusloom
NEXUSLOOM_DATA_DIR=/opt/corps/nexusloom/data
NEXUSLOOM_API_KEY=
# 备份文件目录（与 backup 容器挂载一致）
BACKUP_DIR=/opt/corps/backups

# 模型可选；真实短任务验收时才填。不要写进仓库。
DEEPSEEK_API_URL=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=

# 非 LiveKit 演练保持占位；真实音视频验收时替换为独立随机值。
LIVEKIT_API_KEY=UNUSED_LIVEKIT_DISABLED
LIVEKIT_API_SECRET=UNUSED_LIVEKIT_DISABLED
