# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/

# 生成产物（从 design/design-tokens.css 复制，不应入库）
web/app/design-tokens.css

# Production
dist/

# Environment files
.env*.local
.env

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Prisma
web/prisma/migrations/dev.db

# Misc
.cache/
coverage/
*.tsbuildinfo
next-env.d.ts

# 本机环境覆盖（端口冲突等机器专属配置，不入库）
docker-compose.override.yml
# 构建中间产物（全量拷贝自 web/ 的有害构建上下文，已废弃）
build-tmp/

# AI 工具/自动化工作目录
.workbuddy/
workbuddy/
.trash-*/

# 编辑器/IDE 配置碎片
.codeartsdoer/
.zcode/

# 临时诊断脚本
_cmp_*.js
_check_*.js
_demo_*.js
*.patch
Dockerfile.hotfix
.dockerignore.bak

# 本地开发日志与运行时上传产物
*.log
web/uploads/

# 审计文档：正式审计报告入库留存（与 docs/security/ 下渗透测试报告的做法一致），
# 仅忽略 agent/工具产出的临时快照与草稿，避免中间产物污染版本库
docs/audit/*.tmp.md
docs/audit/*.draft.md
docs/audit/tmp/
# Tauri/移动端构建产物
desktop/artifacts/

# Python 门禁脚本被导入时产生的字节码缓存
__pycache__/
*.pyc

# 本机自检的临时产物（deploy 包验证期间生成，文件头已声明不入库）
# 通配覆盖所有后缀：实际出现过 .tmp-fake/（目录）、.tmp-pf.err、.tmp-pf.out，
# 原按后缀列举的规则匹配不到它们（.err/.out 不在列表内，目录也不匹配）
.tmp-*
# Next.js 构建的过期产物目录（本机 build 被中断时留下，形如 .next.stale.<数字>）
web/.next.stale.*

# 部署配置里的真实环境文件（含 POSTGRES_PASSWORD / JWT_*_SECRET 等赋值）
# 模板见 deploy/.env.prod.example —— 只有 .example 才入库
deploy/.env.prod
deploy/.env.prod.local

# Tauri 打包资源里的运行时上传目录（内容为本地测试上传残留，不应入库）
desktop/src-tauri/resources/standalone/uploads/
