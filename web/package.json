{
  "name": "corps-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('fs').copyFileSync('../design/design-tokens.css','app/design-tokens.css')\"",
    "dev": "next dev --turbopack",
    "prebuild": "node -e \"require('fs').copyFileSync('../design/design-tokens.css','app/design-tokens.css')\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.1.8",
    "@tailwindcss/postcss": "4.1.8",
    "lucide-react": "0.513.0",
    "@prisma/client": "6.15.0",
    "better-auth": "1.3.28",
    "stripe": "18.3.0",
    "argon2": "0.41.1",
    "zod": "3.24.4",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "prisma": "6.15.0",
    "tsx": "4.19.4",
    "@types/argon2": "0.15.1",
    "vitest": "3.1.1",
    "@vitejs/plugin-react": "4.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.6.3",
    "jsdom": "25.0.1"
  },
  "pnpm": {
    "overrides": {
      "next": "16.2.6",
      "react": "19.2.0",
      "react-dom": "19.2.0"
    }
