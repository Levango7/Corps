{
  "name": "corps-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "predev": "node -e \"require('fs').copyFileSync('../design/design-tokens.css','app/design-tokens.css')\"",
    "dev": "next dev --turbopack",
    "prebuild": "node -e \"require('fs').copyFileSync('../design/design-tokens.css','app/design-tokens.css')\"",
    "build": "next build",
    "start": "next start",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --config playwright.config.ts",
    "audit:high": "pnpm audit --prod --audit-level=high",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.1",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "0.513.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "18.3.0",
    "tailwindcss": "4.3.3",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.7.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "^10.9.0",
    "jsdom": "25.0.1",
    "prettier": "^3.9.6",
    "prisma": "6.15.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "3.1.1"
  },
  "overrides": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
