# ─── 数据库（本地 Docker：web/docker-compose.yml）────────────────────
# 端口用 15432 而不是 5432：宿主机 5432 落在 Windows WinNAT 保留区间
# （5385–5484）内，直连必然 P1001；映射见 web/docker-compose.override.yml。
# 若把命令跑在 compose 网络里（容器内），主机名写 corps-postgres:5432。
# OWNER 连接：仅用于 prisma db push / migrate（表主，绕过 RLS）
DATABASE_URL="postgresql://postgres:changeme-dev-only@localhost:15432/corps?schema=public"
# RUNTIME 连接（可选，RLS 加固验证用）：非表主角色 corps_app，密码在应用 db/schema.sql 时设置
# DATABASE_URL="postgresql://corps_app:<CORPS_APP_PASSWORD>@localhost:15432/corps?schema=public"

# ─── 认证密钥（生产必须换为强随机值，如 openssl rand -hex 32）─────────
JWT_ACCESS_SECRET="replace-with-secure-random-string"
JWT_REFRESH_SECRET="replace-with-secure-random-string"
BETTER_AUTH_SECRET="replace-with-secure-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe（未配置时计费页自动隐藏升级入口）───────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
# ─── DeepSeek AI（未配置时 AI 功能返回 503）──────────────────────────
DEEPSEEK_API_KEY=""
