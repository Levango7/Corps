// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

// ─── 软删除策略规划（DL-13，P3：文档说明）────────────────────────────
//
// 当前状态：**无软删除**——所有删除均为物理删除（DELETE），删除后数据不可恢复。
// User/Workspace/Task/Document/Decision 等核心实体删除后直接从表中消失，
// 仅通过 schema 级联（onDelete: Cascade/SetNull）维护引用完整性。
//
// 规划方向（后续迭代引入，不在本次 P3 范围内实现）：
//
// 1. **可选字段方案**（推荐）：在关键模型上添加 `deletedAt DateTime?` 字段：
//    ```prisma
//    model Task {
//      ...
//      deletedAt DateTime? @map("deleted_at") @db.Timestamptz
//      @@index([workspaceId, deletedAt])  // 软删除过滤索引
//    }
//    ```
//    - Prisma 默认不过滤 null，添加字段后现有查询不受影响（向后兼容）
//    - 需要数据库迁移（ALTER TABLE ADD COLUMN，可安全在线执行）
//    - 删除操作改为 `update({ deletedAt: new Date() })`，查询加 `where: { deletedAt: null }`
//
// 2. **适用范围**（按数据恢复价值排序）：
//    - Task：用户误删任务是高频客诉，软删除 + 30 天回收站
//    - Document：团队知识沉淀，误删影响大
//    - Workspace：整租户删除，软删除 + 保留期便于误删恢复
//    - Decision / DecisionVersion：版本留痕已部分覆盖，可选
//    - Message / Comment：IM 场景删除即删除，不需要软删除
//
// 3. **查询改造**：引入 Prisma middleware 或显式 where 扩展：
//    ```ts
//    prisma.task.findMany({ where: { deletedAt: null, ... } })
//    ```
//    或用 Prisma Client Extensions（$extends）自动注入软删除过滤。
//
// 4. **清理策略**：定时任务（cron）清理 deletedAt 超过保留期的记录：
//    ```ts
//    await prisma.task.deleteMany({ where: { deletedAt: { lt: thirtyDaysAgo } } })
//    ```
//
// 5. **风险**：
//    - 唯一约束需改为 partial index（WHERE deleted_at IS NULL）避免软删除行占位
//    - RLS 策略需同步加 deleted_at IS NULL 谓词
//    - 现有查询全部需加 deletedAt: null 过滤，改造量大
//
// 当前不引入的原因：P3 优先级，软删除是系统级变更（涉及查询、索引、RLS、
// 唯一约束），需在 P2 周期统一评估。当前物理删除 + schema 级联在功能上
// 完备，仅缺少"误删恢复"能力，可通过定期备份 + 按需恢复兜底。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 核心实体 ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?   @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @map("avatar_url") @db.Text
  // Better Auth 存储密码哈希（默认字段名 password，映射到 password_hash 列）
  password      String?   @map("password_hash") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz

  members             Member[]
  tasks               Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  comments            Comment[]
  decisions           Decision[]
  decisionVersions    DecisionVersion[]
  notifications       Notification[]
  messages            Message[]
  // IM 升级：消息已读记录 + 聊天在线状态
  messageReads        MessageRead[]
  chatPresences       ChatPresence[]
  // 工作区文档（v0.4.0 队列第 2 项）：用户作为作者的文档列表
  authoredDocuments   Document[]
  ownedWorkspaces     Workspace[]
  sessions            Session[]
  accounts            Account[]
  analyticsEvents     AnalyticsEvent[]
  // 日历集成：用户的外部日历连接（Google/Outlook）
  calendarConnections CalendarConnection[]
  // F1: 决策行动项的指派人反向关联
  actionItems         DecisionActionItem[]
  // F3: 用户仪表盘布局偏好
  dashboardPrefs      UserDashboardPref[]
  // F2: 临时权限授权（限时角色提升，到期自动回收）
  temporaryGrants     TemporaryGrant[]
  // Phase 1 云文档增强：文档版本作者 + 文档评论作者/解决者
  documentVersions    DocumentVersion[]
  documentComments    DocumentComment[]
  resolvedComments    DocumentComment[]    @relation("CommentResolver")

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  ownerId   String   @map("owner_id") @db.Uuid
  plan      String   @default("free") @db.VarChar(20) // free, starter, pro, enterprise
  seatLimit Int      @default(10) @map("seat_limit")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner              User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members            Member[]
  invitations        Invitation[]
  tasks              Task[]
  comments           Comment[]
  decisions          Decision[]
  decisionVersions   DecisionVersion[]
  notifications      Notification[]
  messages           Message[]
  messageAttachments MessageAttachment[]
  subscriptions      Subscription?
  analyticsEvents    AnalyticsEvent[]
  labels             Label[]
  milestones         Milestone[]
  // 工作区文档中心（v0.4.0 队列第 2 项）：团队知识沉淀，与决策正交（不绑任务）
  documents          Document[]
  // F2: 模块权限覆盖（按角色+模块粒度）
  memberPermissions  MemberPermission[]
  // F3: 用户仪表盘布局偏好
  dashboardPrefs     UserDashboardPref[]
  // F2: 临时权限授权（限时角色提升，到期自动回收）
  temporaryGrants    TemporaryGrant[]
  // Phase 1 云文档增强：知识库空间 + 文件夹 + 文档版本 + 文档评论
  spaces             Space[]
  folders            Folder[]
  documentVersions   DocumentVersion[]
  documentComments   DocumentComment[]

  @@index([ownerId])
  @@map("workspaces")
}

model Member {
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  role        String   @default("member") @db.VarChar(20) // owner, admin, member, viewer
  invitedBy   String?  @map("invited_by") @db.Uuid
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz
  invitedAt   DateTime @default(now()) @map("invited_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("members")
}

/**
 * 邀请未注册用户：owner/admin 生成一次性邀请链接（token 明文只出现在响应中一次，
 * 库中仅存 sha256 哈希）。同一 (workspace, email) 的 pending 邀请可被重新生成
 * （覆盖 token_hash 并延长过期时间）。受邀人以匹配邮箱注册后凭 token 接受邀请。
 */
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String    @db.VarChar(255)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  role        String    @default("member") @db.VarChar(20)
  invitedBy   String    @map("invited_by") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 同 (workspace, email) 的 pending 邀请唯一由 DB 层 partial unique index
  // （uq_invitations_pending，WHERE accepted_at IS NULL）保证，见迁移
  // 20260827100000。Prisma schema 无法表达 partial index，故此处不声明
  // @@unique，避免 `prisma migrate dev` 误判 drift 重建为 full unique。
  @@index([email])
  @@map("invitations")
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  title          String    @db.VarChar(255)
  description    String?   @map("description") @db.Text
  status         String    @default("todo") @db.VarChar(20) // todo, in_progress, review, done
  priority       String    @default("medium") @db.VarChar(20) // low, medium, high, urgent
  assigneeId     String?   @map("assignee_id") @db.Uuid
  dueDate        DateTime? @map("due_date") @db.Timestamptz
  sortOrder      Float     @default(0) @map("sort_order")
  createdBy      String?   @map("created_by") @db.Uuid
  // 里程碑归属（可选）：null 表示未归入任何里程碑
  milestoneId    String?   @map("milestone_id") @db.Uuid
  // 子任务：父任务 ID（自关联，仅一层——父级本身不能是子任务，API 层强制）
  parentId       String?   @map("parent_id") @db.Uuid
  // 阻塞标记：任务被问题/依赖卡住时置 true，附原因说明
  blocked        Boolean   @default(false)
  blockedReason  String?   @map("blocked_reason") @db.VarChar(500)
  // 任务公开分享 token（v0.4 队列第 6 项：只读快照外链，null=未分享）
  shareToken     String?   @unique @map("task_share_token") @db.VarChar(64)
  // F5: 分享过期时间（null = 永不过期）
  shareExpiresAt DateTime? @map("share_expires_at") @db.Timestamptz
  // F5: 分享密码 hash（null = 无密码；scrypt hash）
  sharePassword  String?   @map("share_password") @db.VarChar(100)
  // F5: 自定义分享路径（null = 使用默认 shareToken；小写字母/数字/连字符，3-50 字符）
  shareSlug      String?   @map("share_slug") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee       User?                @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // 创建者注销后任务保留，creator 置空（审计 D3：防跨工作区级联销毁）
  creator        User?                @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  milestone      Milestone?           @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  // 子任务自关联：父任务删除时子任务一并删除（子任务语义上从属于父任务）
  parent         Task?                @relation("TaskChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children       Task[]               @relation("TaskChildren")
  comments       Comment[]
  decisions      Decision[]
  messages       Message[]
  // IM 升级：任务内聊天在线状态
  chatPresences  ChatPresence[]
  labels         TaskLabel[]
  // 日历集成：任务同步到外部日历的事件映射
  calendarEvents TaskCalendarEvent[]
  // F1: 决策自动分解生成的行动项（此任务由某个决策的行动项创建）
  actionItems    DecisionActionItem[] @relation("DecisionActionTask")

  // 看板视图：按工作区筛选任务状态列
  @@index([workspaceId, status])
  // 任务时间线/最近活动排序
  @@index([workspaceId, createdAt])
  // 我的任务：按工作区 + 负责人筛选
  @@index([workspaceId, assigneeId])
  // 看板拖拽排序：按工作区 + sortOrder 高效分页
  @@index([workspaceId, sortOrder])
  // 里程碑筛选：按工作区 + 里程碑高效分页
  @@index([workspaceId, milestoneId])
  // 子任务列表：按父任务取子任务（任务详情页子任务区）
  @@index([parentId])
  // 看板列内拖拽排序：按工作区 + 状态 + 排序值高效查询
  // 覆盖看板页「按列分组 + 列内按 sortOrder 排序」高频查询，避免回表 + 两次索引扫描
  @@index([workspaceId, status, sortOrder])
  // 跨工作区的负责人查询（保留单列索引以兼容现有查询）
  @@index([assigneeId])
  @@map("tasks")
}

// ─── 任务标签（P4：看板标签/里程碑）──

/**
 * 工作区级标签：name + color，由 owner/admin 维护。
 * color 存 hex（如 #ef4444）或 CSS 变量（如 var(--danger)），前端原样渲染。
 */
model Label {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(50)
  color       String   @default("var(--muted)") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  // 同工作区内标签名唯一（大小写敏感）
  @@unique([workspaceId, name], name: "uq_labels_workspace_name")
  @@index([workspaceId])
  @@map("labels")
}

/**
 * 任务-标签多对多关联表。
 * 复合主键 (taskId, labelId) 避免重复关联。
 */
model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

/**
 * 里程碑：工作区内的阶段性目标，含名称、截止日期、描述。
 * 任务通过 Task.milestoneId 归属到某里程碑（可空）。
 */
model Milestone {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(100)
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@map("milestones")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  body        String   @db.Text
  mentions    String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后评论保留（审计 D3）
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // 任务详情页：按时间顺序加载评论（覆盖索引前缀）
  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@map("comments")
}

// ─── 任务级即时聊天消息（v2 F1：IM 轻沟通 MVP）──
// 与 Comment（异步评论）区分：Message 是任务上下文内的轻量实时聊天。
// MVP 采用轮询方案（5s 间隔 + ?since= 游标增量拉取），后续可升级 SSE/WebSocket。
// messages 已纳入 db/rls-activate.sql 的 FORCE RLS（workspace 谓词，审计 P2-3 修复）。

model Message {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  body        String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  task        Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后消息保留（审计 D3）
  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // IM 升级：已读记录 + 文件附件
  reads       MessageRead[]
  attachments MessageAttachment[]

  // 任务聊天：按时间顺序加载消息（覆盖索引前缀，兼容增量游标 ?since= 查询）
  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@map("messages")
}

// ─── IM 升级：消息已读记录（v2 F2：已读回执）──
// 每条 (messageId, userId) 唯一记录一次已读时间戳，用于双勾✓✓回执展示。
// onDelete: Cascade 跟随消息删除自动清理，避免悬空引用。

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同一用户对同一消息只记录一次已读
  @@unique([messageId, userId])
  // 按消息查询已读列表（已读回执展示）
  @@index([messageId])
  // 按用户查询已读消息（未读计数）
  @@index([userId])
  @@map("message_reads")
}

// ─── IM 升级：消息文件附件（v2 F4：文件分享）──
// 一条消息可携带多个附件（图片/文档），MVP 本地存储到 web/uploads/。
// thumbnailUrl 仅图片类型生成，用于聊天内预览；其他类型为 null。

// ─── 工作区文档中心（v0.4.0 队列第 2 项）────────────────────────────

/**
 * 文档与决策记录正交：决策绑任务解决「为什么这么定」，
 * 文档解绑任务解决「团队公约/新人手册/方案沉淀」。
 * 复用决策记录的 markdown + Mermaid 思路；不维护完整历史版本
 * （文档以 publishedMarkdown 指向最新发布快照，编辑时草稿在 markdown 字段）。
 * 分享链接：shareToken 唯一随机串，GET /documents/share/:token 公开访问，
 * 不需要登录（v0.4 不预设：未来升级为可选密码/过期时间）。
 */
model Document {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  title             String    @db.VarChar(255)
  /**
   * 文档正文（markdown + 可选 markdown-mermaid 代码块；前端 markdown-it 渲染）
   */
  markdown          String    @default("") @db.Text
  /**
   * 当前已发布版本（null 表示从未发布过；编辑文档时工作草稿在 markdown 字段）
   */
  publishedMarkdown String?   @map("published_markdown") @db.Text
  /**
   * 发布时间戳（null = 草稿）
   */
  publishedAt       DateTime? @map("published_at") @db.Timestamptz
  /**
   * 分享链接 token（unique 索引；null 表示未启用分享）
   */
  shareToken        String?   @unique @map("share_token") @db.VarChar(64)
  /**
   * F5: 分享过期时间（null = 永不过期）
   */
  shareExpiresAt    DateTime? @map("share_expires_at") @db.Timestamptz
  /**
   * F5: 分享密码 hash（null = 无密码；scrypt hash）
   */
  sharePassword     String?   @map("share_password") @db.VarChar(100)
  /**
   * F5: 自定义分享路径（null = 使用默认 shareToken；小写字母/数字/连字符，3-50 字符）
   */
  shareSlug         String?   @map("share_slug") @db.VarChar(100)
  /**
   * 文档作者（可编辑；展示用）
   */
  authorId          String?   @map("author_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // ── Phase 1 云文档增强（增量字段，不破坏现有数据）──
  /**
   * /** 知识库空间 ID（新增；null = 迁移期未归类文档，UI 显示在"未分类"区）
   */
  spaceId        String? @map("space_id") @db.Uuid
  /**
   * 所属文件夹 ID（新增；null = 空间根目录下的文档）
   */
  folderId       String? @map("folder_id") @db.Uuid
  /**
   * 同层级排序值（新增；拖拽排序，复用 Task.sortOrder 方案）
   */
  sortOrder      Float   @default(0) @map("sort_order")
  /**
   * 文档图标（新增；Lucide 图标名，默认 file-text）
   */
  icon           String  @default("file-text") @db.VarChar(50)
  /**
   * 文档 emoji 封面（新增；可选，用于文档列表视觉区分）
   */
  emoji          String? @db.VarChar(10)
  /**
   * 当前版本号（新增；每次创建版本递增）
   */
  currentVersion Int     @default(0) @map("current_version")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Phase 1 知识库关联
  space     Space?            @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  folder    Folder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions  DocumentVersion[]
  comments  DocumentComment[]
  // Phase 2 协同编辑：Yjs CRDT 状态持久化（一对一，文档删除时级联清除协同状态）
  yjsPersistence YjsPersistence?

  // 工作区内文档搜索
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, title])
  // 知识库目录树查询：按空间 + 文件夹 + 排序
  @@index([spaceId, folderId, sortOrder])
  @@map("documents")
}

model MessageAttachment {
