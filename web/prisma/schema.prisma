// ─── 分析事件（P2 数据埋点：注册/激活/留存/转化漏斗）──

/**
 * 分析事件表：客户端批量上报，服务端按工作区隔离。
 * 设计权衡：
 * - 不在事件写入路径走 RLS（事件写入用 runWithAuthOp("provision") 逃生口 + 显式 workspace_id），
 * 因为事件可能在 wid 上下文建立之前发生（如 register）。
 * - 读取（analytics/overview）走 RLS，仅 owner/admin 可见。
 * - props 用 Json 而非 JsonB：写入少、读取多，Json 行内存储读取更快；
 * 且事件 props 体量小（<1KB），不需要 JsonB 的 GIN 索引。
 * - 不存 PII（邮箱/姓名），仅存匿名化 props（taskId/role/plan 等）。
 * ─── GIN 索引策略（DL-16，P3：文档说明）────────────────────────────
 * 当前 props 为 JSON 类型，无 GIN 索引。查询均按 name/userId/workspaceId/
 * sessionId + createdAt 走 B-tree 索引，不做 props 内部字段过滤。
 * 若后续需要按 props 内部字段查询（如按 props.taskId 筛选事件），需：
 * 1. 将 props 从 JSON 改为 JSONB（ALTER TABLE ... ALTER COLUMN props
 * TYPE JSONB USING props::JSONB；在线可执行，但大表会锁表，需 pg_repack）
 * 2. 创建 GIN 索引：
 * - 全字段：CREATE INDEX ... ON analytics_events USING GIN (props);
 * - 路径表达式：CREATE INDEX ... ON analytics_events USING GIN ((props->>'taskId'));
 * 3. Prisma schema 改为 `props JsonB @default("{}")`（Prisma 已支持 JsonB）
 * 当前不引入的原因：无 props 内部字段查询需求，所有查询走 B-tree 索引即可。
 * 引入 GIN 会增加写入开销（每次写入需更新 GIN 倒排索引）与存储成本。
 * 参考迁移 SQL 见 db/jsonb-gin-index-reference.sql（不自动执行）。
 */
model AnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // register 前的事件可为空
  workspaceId String?  @map("workspace_id") @db.Uuid // 全局事件（register）可为空
  name        String   @db.VarChar(64) // register, login, create_task, invite_member, create_decision, ...
  props       Json     @default("{}")
  sessionId   String?  @map("session_id") @db.VarChar(64) // 匿名会话 ID，用于漏斗关联
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 漏斗分析：按事件名 + 时间范围扫描
  @@index([name, createdAt])
  // 用户时间线：按用户 + 时间倒序
  @@index([userId, createdAt])
  // 工作区聚合：按工作区 + 时间范围
  @@index([workspaceId, createdAt])
  // 会话关联：按会话 ID 重建漏斗
  @@index([sessionId, createdAt])
  // 漏斗分析：按工作区 + 事件名 + 时间范围扫描（复合索引覆盖高频聚合，避免回表）
  @@index([workspaceId, name, createdAt])
  @@map("analytics_events")
}

// ─── 日历集成（calendar-integration）──
// 用户的外部日历连接（Google Calendar / Outlook Calendar）。
// accessToken / refreshToken 用 AES-256-GCM 加密存储（见 web/lib/crypto.ts）。
// 同一用户同一 provider 只保留一条连接（@@unique([userId, provider])）。

model CalendarConnection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  provider       String    @db.VarChar(20) // "google" | "outlook"
  email          String    @db.VarChar(255) // 连接的日历邮箱
  accessToken    String    @map("access_token") @db.Text // 加密存储
  refreshToken   String    @map("refresh_token") @db.Text // 加密存储
  tokenExpiresAt DateTime  @map("token_expires_at") @db.Timestamptz
  calendarId     String    @map("calendar_id") @db.VarChar(255) // 外部日历 ID
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz
  syncStatus     String    @default("idle") @map("sync_status") @db.VarChar(20) // "idle" | "syncing" | "error"
  syncError      String?   @map("sync_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskEvents TaskCalendarEvent[]

  // 同一用户同一 provider 只保留一条连接
  @@unique([userId, provider])
  @@index([userId])
  @@map("calendar_connections")
}

// 任务-日历事件映射：记录每个任务在每个连接的外部事件 ID，用于更新/删除同步。
// onDelete: Cascade 跟随任务/连接删除自动清理，避免悬空引用。

model TaskCalendarEvent {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  externalEventId String   @map("external_event_id") @db.VarChar(255) // 外部日历事件 ID
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.Timestamptz

  task       Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // 同一任务在同一连接只保留一条事件映射
  @@unique([taskId, connectionId])
  @@index([connectionId])
  @@map("task_calendar_events")
}

// ─── F1: 决策驱动执行 — 行动项与任务关联表 ───
// 每个行动项从决策 Markdown 中解析得出，可自动创建 Task。
// 同步策略：新增行动项→创建Task+ActionItem；删除行动项→标记removed=true（Task保留）；
// 用户手动改Task→标记userModified=true，停止该字段自动同步。

model DecisionActionItem {
  id           String    @id @default(uuid()) @db.Uuid
  decisionId   String    @map("decision_id") @db.Uuid
  taskId       String?   @map("task_id") @db.Uuid // null = 行动项已删除，Task 保留
  lineIndex    Int       @map("line_index") // markdown 中的行号（用于 diff 同步）
  checked      Boolean   @default(false)
  assigneeId   String?   @map("assignee_id") @db.Uuid
  dueDate      DateTime? @map("due_date") @db.Timestamptz
  priority     String    @default("medium") @db.VarChar(20)
  title        String    @db.VarChar(500)
  removed      Boolean   @default(false) // 行动项从 markdown 中删除
  userModified Boolean   @default(false) @map("user_modified") // 用户手动改过 Task，停止字段同步
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  task     Task?    @relation("DecisionActionTask", fields: [taskId], references: [id], onDelete: SetNull)
  assignee User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([decisionId])
  @@index([taskId])
  @@map("decision_action_items")
}

// ─── F2: Viewer 角色 + 模块权限矩阵 — 权限覆盖表 ───
// 按角色+模块粒度覆盖默认权限。owner/admin 不可覆盖（短路返回 true）。
// 仅对 member/viewer 生效。actions 为空数组=完全禁止该模块。

model MemberPermission {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  role        String   @db.VarChar(20) // "member" | "viewer"（owner/admin 不可覆盖）
  module      String   @db.VarChar(30) // "tasks"|"decisions"|"documents"|"messages"|"members"|"billing"|"analytics"|"settings"
  actions     String[] @default([]) // ["read","create","update","delete"]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role, module], name: "uq_member_perm")
  @@index([workspaceId])
  @@map("member_permissions")
}

// ─── F3: Widget 仪表盘 — 用户工作区布局偏好 ───
// 每个用户在每个工作区有独立的 Widget 布局配置（react-grid-layout 格式）。
// 无配置时使用角色默认布局（default-layouts.ts）。

model UserDashboardPref {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  layout      Json // react-grid-layout 布局配置 [{i: "widget-id", x, y, w, h, minW, minH}]
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("user_dashboard_prefs")
}

// ─── F5: 分享增强 — 访问日志 ───
// 记录通过分享链接访问文档/任务的日志，用于审计和安全性分析。

model ShareAccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(20) // "document" | "task"
  entityId   String   @map("entity_id") @db.Uuid
  ip         String?  @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  accessedAt DateTime @default(now()) @map("accessed_at") @db.Timestamptz

  @@index([entityType, entityId, accessedAt])
  @@map("share_access_logs")
}

// ─── F2: 临时权限授权 — 限时角色提升，到期自动回收 ───
// 管理员可为成员授予限时权限（如临时提升为 admin 角色），到期后由
// /api/cron/check-expired-permissions 定时任务自动恢复原角色并删除授权记录。
// 同一 (userId, workspaceId) 仅保留一条有效授权（@@unique）。
// 注意：本表启用 RLS（见 db/rls-activate.sql），成员可读自己工作区的授权，
// 仅 owner/admin 可写。cron 作业通过 auth_op='cron' 逃生口跨工作区扫描过期记录。

model TemporaryGrant {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// 临时角色（如 "admin"），到期后回退到原角色
  tempRole     String   @map("temp_role") @db.VarChar(20)
  /// 原角色（到期后恢复）
  originalRole String   @map("original_role") @db.VarChar(20)
  /// 到期时间
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  /// 授予原因（可选）
  reason       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 同一用户在同一工作区仅保留一条临时授权（覆盖语义：重新授权更新现有记录）
  @@unique([userId, workspaceId])
  // cron 作业按工作区 + 过期时间扫描高效索引
  @@index([workspaceId, expiresAt])
  @@map("temporary_grants")
}

// ─── Phase 1 云文档增强（设计文档 §2.2 / §2.3 / §2.4 / §6）──────────────────
// 知识库结构：Workspace → Space → Folder → Document 层级
// 文档版本历史：DocumentVersion 快照（full / diff 两种存储策略）
// 文档行内批注：DocumentComment（锚点 + 讨论线程 + 解决状态）

/// 知识库空间：Workspace 下的顶层文档容器（如"产品文档"/"技术文档"/"团队规范"）
model Space {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(100)
  /// 空间图标（Lucide 图标名，如 "book" / "code" / "users"）
  icon        String   @default("book") @db.VarChar(50)
  /// 排序值（拖拽排序，复用 Task.sortOrder 方案）
  sortOrder   Float    @default(0) @map("sort_order")
  /// 空间颜色（CSS 变量或 hex，用于图标着色）
  color       String   @default("var(--accent)") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folders   Folder[]
  // 空间根目录下的文档（folderId = null）
  documents Document[]

  // 同一工作区内空间名唯一
  @@unique([workspaceId, name], name: "uq_spaces_workspace_name")
  @@index([workspaceId, sortOrder])
  @@map("spaces")
}

/// 文件夹：Space 下的文档组织单元，可嵌套（最多 5 层，API 层强制）
model Folder {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  spaceId     String   @map("space_id") @db.Uuid
  /// 父文件夹 ID（null = 空间根目录）；自关联，最多 5 层嵌套
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(100)
  /// 图标（Lucide 图标名，默认 folder）
  icon        String   @default("folder") @db.VarChar(50)
  /// 排序值（同层级内拖拽排序）
  sortOrder   Float    @default(0) @map("sort_order")
  /// 是否默认展开（目录树 UI 状态）
  expanded    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space     Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderChildren")
  documents Document[]

  // 目录树查询：按空间 + 父文件夹 + 排序
  @@index([spaceId, parentId, sortOrder])
  @@index([workspaceId])
  @@map("folders")
}

/// 文档版本历史快照（设计文档 §2.3）
/// 存储优化：full=全量快照，diff=增量差分；首个版本存全量，后续存 diff，每 10 版本强制全量
model DocumentVersion {
  id           String   @id @default(uuid()) @db.Uuid
  documentId   String   @map("document_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  /// 版本号（递增）
  version      Int
  /// 版本类型：full（全量快照）| diff（增量差分）
  snapshotType String   @map("snapshot_type") @db.VarChar(10) // full | diff
  /// 全量快照（snapshotType=full 时）：完整 JSON doc
  contentFull  Json?    @map("content_full")
  /// 增量 diff（snapshotType=diff 时）：相对上一版本的 diff
  contentDiff  String?  @map("content_diff") @db.Text
  /// 该版本的 Markdown 序列化（用于版本对比展示）
  markdown     String   @db.Text
  /// 版本说明（用户输入，可选）
  message      String?  @db.VarChar(255)
  /// 版本来源：publish（发布）| manual（手动）| auto（自动）| collaborative（协同）
  source       String   @default("manual") @db.VarChar(20)
  authorId     String?  @map("author_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // 同一文档版本号唯一
  @@unique([documentId, version], name: "uq_doc_versions_doc_version")
  // 版本历史按文档 + 创建时间查询
  @@index([documentId, createdAt])
  @@index([workspaceId])
  @@map("document_versions")
}

/// 文档行内批注（评论，设计文档 §2.4）
/// 锚点策略：anchorPath=ProseMirror 节点路径，anchorText=锚点文本片段（模糊匹配）
model DocumentComment {
  id          String    @id @default(uuid()) @db.Uuid
  documentId  String    @map("document_id") @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// 批注锚点：ProseMirror 节点路径（如 "1.2.0"），定位到具体段落/文本
  anchorPath  String    @map("anchor_path") @db.VarChar(100)
  /// 批注锚点文本片段（用于锚点失效时模糊匹配）
  anchorText  String    @map("anchor_text") @db.Text
  /// 批注内容（Markdown）
  body        String    @db.Text
  /// @提及的用户 ID 列表
  mentions    String[]  @default([])
  /// 父评论 ID（讨论线程：首条评论 + 回复）
  parentId    String?   @map("parent_id") @db.Uuid
  /// 是否已解决
  resolved    Boolean   @default(false)
  /// 解决者
  resolvedBy  String?   @map("resolved_by") @db.Uuid
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  authorId    String?   @map("author_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  document  Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    DocumentComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   DocumentComment[] @relation("CommentReplies")
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  resolver  User?             @relation("CommentResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  // 按文档 + 锚点路径查询
  @@index([documentId, anchorPath])
  // 按文档 + 解决状态筛选
  @@index([documentId, resolved])
  @@index([workspaceId])
  @@map("document_comments")
}
/// ─── Phase 2 协同编辑：Yjs CRDT 状态持久化（设计文档 §3.1.2 L849-862）──
///
/// Yjs state vector 存入 PostgreSQL（Bytea 二进制列）。
/// 每个文档对应一行（@@unique([documentId])），存储 Y.encodeStateAsUpdate(doc) 的完整状态。
/// 协同服务端（server/collab/y-websocket-server.ts）启动时加载此状态，
/// 编辑更新增量写入（Y.applyUpdate），实现跨会话/跨用户的 CRDT 状态恢复。
model YjsPersistence {
  id         String   @id @default(uuid()) @db.Uuid
  /// 文档 ID（关联 Document；一对一——每个文档仅存一份 CRDT 状态）
  documentId String   @map("document_id") @db.Uuid
  /// Yjs 二进制状态（Y.encodeStateAsUpdate 的输出，Bytea 存储）
  state      Bytes    @db.Bytea
  /// 最后更新时间（协同服务端每次写入增量更新时刷新）
  updatedAt  DateTime @updatedAt @db.Timestamptz @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId])
  @@map("yjs_persistence")
}
