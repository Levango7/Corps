// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 核心实体 ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?   @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @map("avatar_url") @db.Text
  // Better Auth 存储密码哈希（默认字段名 password，映射到 password_hash 列）
  password      String?   @map("password_hash") @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt     DateTime  @updatedAt @db.Timestamptz @map("updated_at") 
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz

  members          Member[]
  tasks            Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  comments         Comment[]
  decisions        Decision[]
  decisionVersions DecisionVersion[]
  notifications    Notification[]
  messages         Message[]
  // IM 升级：消息已读记录 + 聊天在线状态
  messageReads     MessageRead[]
  chatPresences    ChatPresence[]
  ownedWorkspaces  Workspace[]
  sessions         Session[]
  accounts         Account[]
  analyticsEvents  AnalyticsEvent[]
  // 日历集成：用户的外部日历连接（Google/Outlook）
  calendarConnections CalendarConnection[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  ownerId   String   @map("owner_id") @db.Uuid
  plan      String   @default("free") @db.VarChar(20) // free, starter, pro, enterprise
  seatLimit Int      @default(10) @map("seat_limit")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members          Member[]
  invitations      Invitation[]
  tasks            Task[]
  comments         Comment[]
  decisions        Decision[]
  decisionVersions DecisionVersion[]
  notifications    Notification[]
  messages         Message[]
  messageAttachments MessageAttachment[]
  subscriptions    Subscription?
  analyticsEvents  AnalyticsEvent[]
  labels           Label[]
  milestones       Milestone[]

  @@index([ownerId])
  @@map("workspaces")
}

model Member {
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  role        String   @default("member") @db.VarChar(20) // owner, admin, member
  invitedBy   String?  @map("invited_by") @db.Uuid
  joinedAt    DateTime @default(now()) @db.Timestamptz @map("joined_at") 
  invitedAt   DateTime @default(now()) @db.Timestamptz @map("invited_at") 

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("members")
}

/**
 * 邀请未注册用户：owner/admin 生成一次性邀请链接（token 明文只出现在响应中一次，
 * 库中仅存 sha256 哈希）。同一 (workspace, email) 的 pending 邀请可被重新生成
 * （覆盖 token_hash 并延长过期时间）。受邀人以匹配邮箱注册后凭 token 接受邀请。
 */
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String    @db.VarChar(255)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  role        String    @default("member") @db.VarChar(20)
  invitedBy   String    @map("invited_by") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at") 

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 同 (workspace, email) 的 pending 邀请唯一由 DB 层 partial unique index
  // （uq_invitations_pending，WHERE accepted_at IS NULL）保证，见迁移
  // 20260827100000。Prisma schema 无法表达 partial index，故此处不声明
  // @@unique，避免 `prisma migrate dev` 误判 drift 重建为 full unique。
  @@index([email])
  @@map("invitations")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @map("description") @db.Text
  status      String    @default("todo") @db.VarChar(20) // todo, in_progress, review, done
  priority    String    @default("medium") @db.VarChar(20) // low, medium, high, urgent
  assigneeId  String?   @map("assignee_id") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  sortOrder   Float     @default(0) @map("sort_order")
  createdBy   String?   @map("created_by") @db.Uuid
  // 里程碑归属（可选）：null 表示未归入任何里程碑
  milestoneId String?   @map("milestone_id") @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at") 

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // 创建者注销后任务保留，creator 置空（审计 D3：防跨工作区级联销毁）
  creator   User?      @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  comments  Comment[]
  decisions Decision[]
  messages  Message[]
  // IM 升级：任务内聊天在线状态
  chatPresences ChatPresence[]
  labels    TaskLabel[]
  // 日历集成：任务同步到外部日历的事件映射
  calendarEvents TaskCalendarEvent[]

  // 看板视图：按工作区筛选任务状态列
  @@index([workspaceId, status])
  // 任务时间线/最近活动排序
  @@index([workspaceId, createdAt])
  // 我的任务：按工作区 + 负责人筛选
  @@index([workspaceId, assigneeId])
  // 看板拖拽排序：按工作区 + sortOrder 高效分页
  @@index([workspaceId, sortOrder])
  // 里程碑筛选：按工作区 + 里程碑高效分页
  @@index([workspaceId, milestoneId])
  // 看板列内拖拽排序：按工作区 + 状态 + 排序值高效查询
  // 覆盖看板页「按列分组 + 列内按 sortOrder 排序」高频查询，避免回表 + 两次索引扫描
  @@index([workspaceId, status, sortOrder])
  // 跨工作区的负责人查询（保留单列索引以兼容现有查询）
  @@index([assigneeId])
  @@map("tasks")
}

// ─── 任务标签（P4：看板标签/里程碑）──

/**
 * 工作区级标签：name + color，由 owner/admin 维护。
 * color 存 hex（如 #ef4444）或 CSS 变量（如 var(--danger)），前端原样渲染。
 */
model Label {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String   @db.VarChar(50)
  color       String   @default("var(--muted)") @db.VarChar(50)
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  // 同工作区内标签名唯一（大小写敏感）
  @@unique([workspaceId, name], name: "uq_labels_workspace_name")
  @@index([workspaceId])
  @@map("labels")
}

/**
 * 任务-标签多对多关联表。
 * 复合主键 (taskId, labelId) 避免重复关联。
 */
model TaskLabel {
  taskId  String @map("task_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

/**
 * 里程碑：工作区内的阶段性目标，含名称、截止日期、描述。
 * 任务通过 Task.milestoneId 归属到某里程碑（可空）。
 */
model Milestone {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String    @db.VarChar(100)
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@map("milestones")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  body        String   @db.Text
  mentions    String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后评论保留（审计 D3）
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // 任务详情页：按时间顺序加载评论（覆盖索引前缀）
  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@map("comments")
}

// ─── 任务级即时聊天消息（v2 F1：IM 轻沟通 MVP）──
// 与 Comment（异步评论）区分：Message 是任务上下文内的轻量实时聊天。
// MVP 采用轮询方案（5s 间隔 + ?since= 游标增量拉取），后续可升级 SSE/WebSocket。
// messages 已纳入 db/rls-activate.sql 的 FORCE RLS（workspace 谓词，审计 P2-3 修复）。

model Message {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  body        String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at")

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后消息保留（审计 D3）
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // IM 升级：已读记录 + 文件附件
  reads       MessageRead[]
  attachments MessageAttachment[]

  // 任务聊天：按时间顺序加载消息（覆盖索引前缀，兼容增量游标 ?since= 查询）
  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@map("messages")
}

// ─── IM 升级：消息已读记录（v2 F2：已读回执）──
// 每条 (messageId, userId) 唯一记录一次已读时间戳，用于双勾✓✓回执展示。
// onDelete: Cascade 跟随消息删除自动清理，避免悬空引用。

model MessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @db.Timestamptz @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同一用户对同一消息只记录一次已读
  @@unique([messageId, userId])
  // 按消息查询已读列表（已读回执展示）
  @@index([messageId])
  // 按用户查询已读消息（未读计数）
  @@index([userId])
  @@map("message_reads")
}

// ─── IM 升级：消息文件附件（v2 F4：文件分享）──
// 一条消息可携带多个附件（图片/文档），MVP 本地存储到 web/uploads/。
// thumbnailUrl 仅图片类型生成，用于聊天内预览；其他类型为 null。

model MessageAttachment {
  id           String  @id @default(uuid()) @db.Uuid
  messageId    String  @map("message_id") @db.Uuid
  // 附件租户归属（20260831000000 迁移）：下载端点据此做归属校验，RLS 可按此谓词纳入
  workspaceId  String  @map("workspace_id") @db.Uuid
  fileName     String  @map("file_name") @db.VarChar(255)
  fileSize     Int     @map("file_size")
  fileType     String  @map("file_type") @db.VarChar(100) // MIME type
  url          String  @db.Text // 存储路径（MVP: /uploads/xxx）
  thumbnailUrl String? @map("thumbnail_url") @db.Text // 图片缩略图路径
  createdAt    DateTime @default(now()) @db.Timestamptz @map("created_at")

  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 按消息查询附件列表；按工作区做租户隔离扫描
  @@index([messageId])
  @@index([workspaceId])
  @@map("message_attachments")
}

// ─── IM 升级：聊天在线状态（v2 F3：在线状态指示）──
// 记录用户在某任务聊天中的最近活跃时间，30 秒心跳更新。
// 在线判定：now - lastSeen < 60s 视为在线（容忍一次心跳丢失）。

model ChatPresence {
  id       String   @id @default(uuid()) @db.Uuid
  taskId   String   @map("task_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  lastSeen DateTime @default(now()) @db.Timestamptz @map("last_seen")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同一用户在同一任务中只保留一条在线状态
  @@unique([taskId, userId])
  // 按任务查询在线成员列表
  @@index([taskId])
  @@map("chat_presences")
}

// ─── 通知（mention / task_assigned / task_updated / comment_added / decision_updated）──

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  type        String   @db.VarChar(30) // mention, task_assigned, task_updated, comment_added, decision_updated
  entityId    String   @map("entity_id") @db.Uuid // 关联的任务 ID
  entityTitle String   @map("entity_title") @db.VarChar(255) // 冗余存储任务标题
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 用户在某工作区的通知列表
  @@index([userId, workspaceId])
  // 工作区维度的通知查询
  @@index([workspaceId])
  // 未读通知计数与筛选（高频查询：工作区 + 用户 + 已读状态）
  @@index([workspaceId, userId, read])
  // 通知中心按时间倒序分页（游标分页）
  @@index([workspaceId, createdAt])
  // 未读通知按时间倒序分页（高频：工作区 + 已读状态 + 时间，覆盖通知中心未读筛选）
  @@index([workspaceId, read, createdAt])
  @@map("notifications")
}

model Decision {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  markdown    String   @db.Text
  version     Int      @default(1)
  authorId    String?  @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后决策保留（审计 D3）
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  versions  DecisionVersion[]

  // 任务决策按版本号定位（覆盖索引前缀兼容单 taskId 查询）
  @@index([taskId, version])
  @@index([workspaceId])
  @@map("decisions")
}

// ─── Better Auth 托管模型（由 @better-auth/cli generate 校准，1.3 标准形态）──

// ─── 决策版本历史（AC-10: 版本留痕）──

model DecisionVersion {
  id          String   @id @default(uuid()) @db.Uuid
  decisionId  String   @map("decision_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  markdown    String   @db.Text
  version     Int
  authorId    String?  @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 

  decision  Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后版本留痕保留（审计 D3）
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([decisionId])
  @@index([workspaceId])
  @@map("decision_versions")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique @map("token") @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at") 
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 用户会话列表 + 过期时间筛选（清理过期会话、验证有效会话）
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.Text
  providerId            String    @map("provider_id") @db.Text
  // Better Auth 1.7.1 新增字段：标识 account 的签发者（credential 端为 "local:credential"，
  // OAuth 端为 provider 的 issuer URL）。与 accountId 组成唯一键，区分同一用户在不同 provider 的账户。
  issuer                String    @map("issuer") @db.Text
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt             DateTime  @updatedAt @db.Timestamptz @map("updated_at") 

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt  DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  @@map("verifications")
}

model Subscription {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  stripeCustomerId String?   @map("stripe_customer_id") @db.VarChar(255) // 保留列名避免破坏性迁移；语义=通道客户 ID（Phase 2 评估改名）
  stripeSubId      String?   @map("stripe_sub_id") @db.VarChar(255) // 同上；新代码读写请用 providerOrderId
  // PaymentProvider 抽象（ADR-003 §5 落地要点 2）：通道归属与通道侧订单号。
  // provider: 'stripe' | 'wechatpay-native' | 'alipay-page'；NULL=存量回填前的历史行（读取兼容公式 provider ?? "stripe"）
  provider         String?   @map("provider") @db.VarChar(20)
  providerOrderId  String?   @map("provider_order_id") @db.VarChar(255) // 通道侧订阅号（Stripe=sub_xxx）
  quantity         Int       @default(1)
  status           String    @default("active") @db.VarChar(20) // active, past_due, canceled, trialing, incomplete
  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz
  canceledAt       DateTime? @map("canceled_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz @map("created_at")
  updatedAt        DateTime  @updatedAt @db.Timestamptz @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// ─── Webhook 幂等（审计 T2.7：多通道重复事件检测）──
// ProcessedPaymentEvent：泛化幂等表，复合主键 (provider, event_id)。
// 新代码请使用 prisma.processedPaymentEvent。旧表 processed_stripe_events 保留至
// 清理迁移（设计文档 §6.5），旧 ProcessedStripeEvent model 保留以维持 Prisma 与 DB 一致。

model ProcessedPaymentEvent {
  provider   String   @db.VarChar(20) // 与 ProviderId 对齐
  eventId    String   @map("event_id") @db.VarChar(255) // 通道侧事件 ID（evt_xxx 等）
  receivedAt DateTime @default(now()) @db.Timestamptz @map("received_at")

  @@id([provider, eventId])
  @@map("processed_payment_events")
}

// 旧幂等表（保留至 §6.5 清理迁移，P3-1 BLOCKER 修复：本批不 DROP）。
// 新代码不得使用本 model，仅维持 Prisma migrate 与 DB 旧表的一致性。

model ProcessedStripeEvent {
  id         String   @id @db.VarChar(255) // stripe event ID (evt_xxx)
  receivedAt DateTime @default(now()) @db.Timestamptz @map("received_at")

  @@map("processed_stripe_events")
}

// ─── 分析事件（P2 数据埋点：注册/激活/留存/转化漏斗）──

/**
 * 分析事件表：客户端批量上报，服务端按工作区隔离。
 *
 * 设计权衡：
 *  - 不在事件写入路径走 RLS（事件写入用 runWithAuthOp("provision") 逃生口 + 显式 workspace_id），
 *    因为事件可能在 wid 上下文建立之前发生（如 register）。
 *  - 读取（analytics/overview）走 RLS，仅 owner/admin 可见。
 *  - props 用 Json 而非 JsonB：写入少、读取多，Json 行内存储读取更快；
 *    且事件 props 体量小（<1KB），不需要 JsonB 的 GIN 索引。
 *  - 不存 PII（邮箱/姓名），仅存匿名化 props（taskId/role/plan 等）。
 */
model AnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // register 前的事件可为空
  workspaceId String?  @map("workspace_id") @db.Uuid // 全局事件（register）可为空
  name        String   @db.VarChar(64) // register, login, create_task, invite_member, create_decision, ...
  props       Json     @default("{}")
  sessionId   String?  @map("session_id") @db.VarChar(64) // 匿名会话 ID，用于漏斗关联
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 漏斗分析：按事件名 + 时间范围扫描
  @@index([name, createdAt])
  // 用户时间线：按用户 + 时间倒序
  @@index([userId, createdAt])
  // 工作区聚合：按工作区 + 时间范围
  @@index([workspaceId, createdAt])
  // 会话关联：按会话 ID 重建漏斗
  @@index([sessionId, createdAt])
  // 漏斗分析：按工作区 + 事件名 + 时间范围扫描（复合索引覆盖高频聚合，避免回表）
  @@index([workspaceId, name, createdAt])
  @@map("analytics_events")
}

// ─── 日历集成（calendar-integration）──
// 用户的外部日历连接（Google Calendar / Outlook Calendar）。
// accessToken / refreshToken 用 AES-256-GCM 加密存储（见 web/lib/crypto.ts）。
// 同一用户同一 provider 只保留一条连接（@@unique([userId, provider])）。

model CalendarConnection {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  provider      String   @db.VarChar(20) // "google" | "outlook"
  email         String   @db.VarChar(255) // 连接的日历邮箱
  accessToken   String   @map("access_token") @db.Text // 加密存储
  refreshToken  String   @map("refresh_token") @db.Text // 加密存储
  tokenExpiresAt DateTime @map("token_expires_at") @db.Timestamptz
  calendarId    String   @map("calendar_id") @db.VarChar(255) // 外部日历 ID
  lastSyncAt    DateTime? @map("last_sync_at") @db.Timestamptz
  syncStatus    String   @default("idle") @map("sync_status") @db.VarChar(20) // "idle" | "syncing" | "error"
  syncError     String?  @map("sync_error") @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt     DateTime @updatedAt @db.Timestamptz @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskEvents   TaskCalendarEvent[]

  // 同一用户同一 provider 只保留一条连接
  @@unique([userId, provider])
  @@index([userId])
  @@map("calendar_connections")
}

// 任务-日历事件映射：记录每个任务在每个连接的外部事件 ID，用于更新/删除同步。
// onDelete: Cascade 跟随任务/连接删除自动清理，避免悬空引用。

model TaskCalendarEvent {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  externalEventId String   @map("external_event_id") @db.VarChar(255) // 外部日历事件 ID
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.Timestamptz

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  connection  CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // 同一任务在同一连接只保留一条事件映射
  @@unique([taskId, connectionId])
  @@index([connectionId])
  @@map("task_calendar_events")
}
