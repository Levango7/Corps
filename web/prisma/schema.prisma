// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 核心实体 ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?   @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @map("avatar_url") @db.Text
  // Better Auth 存储密码哈希（默认字段名 password，映射到 password_hash 列）
  password      String?   @map("password_hash") @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt     DateTime  @updatedAt @db.Timestamptz @map("updated_at") 
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz

  members          Member[]
  tasks            Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  comments         Comment[]
  decisions        Decision[]
  decisionVersions DecisionVersion[]
  notifications    Notification[]
  ownedWorkspaces  Workspace[]
  sessions         Session[]
  accounts         Account[]
  analyticsEvents  AnalyticsEvent[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  ownerId   String   @map("owner_id") @db.Uuid
  plan      String   @default("free") @db.VarChar(20) // free, starter, pro, enterprise
  seatLimit Int      @default(10) @map("seat_limit")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members          Member[]
  invitations      Invitation[]
  tasks            Task[]
  comments         Comment[]
  decisions        Decision[]
  decisionVersions DecisionVersion[]
  notifications    Notification[]
  subscriptions    Subscription?
  analyticsEvents  AnalyticsEvent[]

  @@index([ownerId])
  @@map("workspaces")
}

model Member {
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  role        String   @default("member") @db.VarChar(20) // owner, admin, member
  invitedBy   String?  @map("invited_by") @db.Uuid
  joinedAt    DateTime @default(now()) @db.Timestamptz @map("joined_at") 
  invitedAt   DateTime @default(now()) @db.Timestamptz @map("invited_at") 

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("members")
}

/**
 * 邀请未注册用户：owner/admin 生成一次性邀请链接（token 明文只出现在响应中一次，
 * 库中仅存 sha256 哈希）。同一 (workspace, email) 的 pending 邀请可被重新生成
 * （覆盖 token_hash 并延长过期时间）。受邀人以匹配邮箱注册后凭 token 接受邀请。
 */
model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String    @db.VarChar(255)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  role        String    @default("member") @db.VarChar(20)
  invitedBy   String    @map("invited_by") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at") 

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email], name: "uq_invitations_pending")
  @@index([email])
  @@map("invitations")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @map("description") @db.Text
  status      String    @default("todo") @db.VarChar(20) // todo, in_progress, review, done
  priority    String    @default("medium") @db.VarChar(20) // low, medium, high, urgent
  assigneeId  String?   @map("assignee_id") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Timestamptz
  sortOrder   Float     @default(0) @map("sort_order")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt   DateTime  @updatedAt @db.Timestamptz @map("updated_at") 

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // 创建者注销后任务保留，creator 置空（审计 D3：防跨工作区级联销毁）
  creator   User?      @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  comments  Comment[]
  decisions Decision[]

  // 看板视图：按工作区筛选任务状态列
  @@index([workspaceId, status])
  // 任务时间线/最近活动排序
  @@index([workspaceId, createdAt])
  // 我的任务：按工作区 + 负责人筛选
  @@index([workspaceId, assigneeId])
  // 看板拖拽排序：按工作区 + sortOrder 高效分页
  @@index([workspaceId, sortOrder])
  // 跨工作区的负责人查询（保留单列索引以兼容现有查询）
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String?  @map("author_id") @db.Uuid
  body        String   @db.Text
  mentions    String[] @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后评论保留（审计 D3）
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // 任务详情页：按时间顺序加载评论（覆盖索引前缀）
  @@index([taskId, createdAt])
  @@index([workspaceId])
  @@map("comments")
}

// ─── 通知（mention / task_assigned / task_updated / comment_added / decision_updated）──

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  type        String   @db.VarChar(30) // mention, task_assigned, task_updated, comment_added, decision_updated
  entityId    String   @map("entity_id") @db.Uuid // 关联的任务 ID
  entityTitle String   @map("entity_title") @db.VarChar(255) // 冗余存储任务标题
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 用户在某工作区的通知列表
  @@index([userId, workspaceId])
  // 工作区维度的通知查询
  @@index([workspaceId])
  // 未读通知计数与筛选（高频查询：工作区 + 用户 + 已读状态）
  @@index([workspaceId, userId, read])
  // 通知中心按时间倒序分页（游标分页）
  @@index([workspaceId, createdAt])
  @@map("notifications")
}

model Decision {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  markdown    String   @db.Text
  version     Int      @default(1)
  authorId    String?  @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt   DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后决策保留（审计 D3）
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  versions  DecisionVersion[]

  // 任务决策按版本号定位（覆盖索引前缀兼容单 taskId 查询）
  @@index([taskId, version])
  @@index([workspaceId])
  @@map("decisions")
}

// ─── Better Auth 托管模型（由 @better-auth/cli generate 校准，1.3 标准形态）──

// ─── 决策版本历史（AC-10: 版本留痕）──

model DecisionVersion {
  id          String   @id @default(uuid()) @db.Uuid
  decisionId  String   @map("decision_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  markdown    String   @db.Text
  version     Int
  authorId    String?  @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 

  decision  Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // 作者注销后版本留痕保留（审计 D3）
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([decisionId])
  @@index([workspaceId])
  @@map("decision_versions")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  token     String   @unique @map("token") @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt DateTime @updatedAt @db.Timestamptz @map("updated_at") 
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 用户会话列表 + 过期时间筛选（清理过期会话、验证有效会话）
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id") @db.Text
  providerId            String    @map("provider_id") @db.Text
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt             DateTime  @updatedAt @db.Timestamptz @map("updated_at") 

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt  DateTime @updatedAt @db.Timestamptz @map("updated_at") 

  @@map("verifications")
}

model Subscription {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  stripeCustomerId String?   @map("stripe_customer_id") @db.VarChar(255)
  stripeSubId      String?   @map("stripe_sub_id") @db.VarChar(255)
  quantity         Int       @default(1)
  status           String    @default("active") @db.VarChar(20) // active, past_due, canceled, trialing, incomplete
  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz
  canceledAt       DateTime? @map("canceled_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz @map("created_at") 
  updatedAt        DateTime  @updatedAt @db.Timestamptz @map("updated_at") 

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// ─── Webhook 幂等（审计 T2.7：Stripe 重复事件检测）──

model ProcessedStripeEvent {
  id         String   @id @db.VarChar(255) // stripe event ID (evt_xxx)
  receivedAt DateTime @default(now()) @db.Timestamptz @map("received_at")

  @@map("processed_stripe_events")
}

// ─── 分析事件（P2 数据埋点：注册/激活/留存/转化漏斗）──

/**
 * 分析事件表：客户端批量上报，服务端按工作区隔离。
 *
 * 设计权衡：
 *  - 不在事件写入路径走 RLS（事件写入用 runWithAuthOp("provision") 逃生口 + 显式 workspace_id），
 *    因为事件可能在 wid 上下文建立之前发生（如 register）。
 *  - 读取（analytics/overview）走 RLS，仅 owner/admin 可见。
 *  - props 用 Json 而非 JsonB：写入少、读取多，Json 行内存储读取更快；
 *    且事件 props 体量小（<1KB），不需要 JsonB 的 GIN 索引。
 *  - 不存 PII（邮箱/姓名），仅存匿名化 props（taskId/role/plan 等）。
 */
model AnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid // register 前的事件可为空
  workspaceId String?  @map("workspace_id") @db.Uuid // 全局事件（register）可为空
  name        String   @db.VarChar(64) // register, login, create_task, invite_member, create_decision, ...
  props       Json     @default("{}")
  sessionId   String?  @map("session_id") @db.VarChar(64) // 匿名会话 ID，用于漏斗关联
  createdAt   DateTime @default(now()) @db.Timestamptz @map("created_at") 

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 漏斗分析：按事件名 + 时间范围扫描
  @@index([name, createdAt])
  // 用户时间线：按用户 + 时间倒序
  @@index([userId, createdAt])
  // 工作区聚合：按工作区 + 时间范围
  @@index([workspaceId, createdAt])
  // 会话关联：按会话 ID 重建漏斗
  @@index([sessionId, createdAt])
  @@map("analytics_events")
}
