// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 核心实体 ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?   @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?   @map("avatar_url") @db.Text
  // Better Auth 存储密码哈希（默认字段名 password，映射到 password_hash 列）
  password      String?   @map("password_hash") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  members         Member[]
  tasks           Task[]       @relation("TaskAssignee")
  createdTasks    Task[]       @relation("TaskCreator")
  comments        Comment[]
  decisions       Decision[]
  decisionVersions DecisionVersion[]
  ownedWorkspaces Workspace[]
  sessions        Session[]
  accounts        Account[]

  @@map("users")
}

model Workspace {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  slug         String   @unique @db.VarChar(50)
  ownerId      String   @map("owner_id") @db.Uuid
  plan         String   @default("free") @db.VarChar(20) // free, starter, pro, enterprise
  seatLimit    Int      @default(10) @map("seat_limit")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members         Member[]
  tasks           Task[]
  comments        Comment[]
  decisions       Decision[]
  decisionVersions DecisionVersion[]
  subscriptions   Subscription?

  @@index([slug])
  @@index([ownerId])
  @@map("workspaces")
}

model Member {
  userId     String   @map("user_id") @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  role       String   @default("member") @db.VarChar(20) // owner, admin, member
  invitedBy  String?  @map("invited_by") @db.Uuid
  joinedAt   DateTime @default(now()) @map("joined_at")
  invitedAt  DateTime @default(now()) @map("invited_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("members")
}

model Task {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @map("description") @db.Text
  status      String   @default("todo") @db.VarChar(20) // todo, in_progress, review, done
  priority    String   @default("medium") @db.VarChar(20) // low, medium, high, urgent
  assigneeId  String?  @map("assignee_id") @db.Uuid
  dueDate     DateTime? @map("due_date")
  sortOrder   Float    @default(0) @map("sort_order")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee     User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User              @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  comments     Comment[]
  decisions    Decision[]

  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  body        String   @db.Text
  mentions    String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([workspaceId])
  @@map("comments")
}

model Decision {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  markdown    String   @db.Text
  version     Int      @default(1)
  authorId    String   @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions  DecisionVersion[]

  @@index([taskId])
  @@index([workspaceId])
  @@map("decisions")
}

// ─── Better Auth 托管模型（由 @better-auth/cli generate 校准，1.3 标准形态）──

// ─── 决策版本历史（AC-10: 版本留痕）──

model DecisionVersion {
  id          String   @id @default(uuid()) @db.Uuid
  decisionId  String   @map("decision_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  markdown    String   @db.Text
  version     Int
  authorId    String   @map("author_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  decision  Decision  @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([workspaceId])
  @@map("decision_versions")
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  expiresAt     DateTime @map("expires_at")
  token         String   @unique @map("token") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                     String    @id @default(uuid()) @db.Uuid
  accountId              String    @map("account_id") @db.Text
  providerId             String    @map("provider_id") @db.Text
  userId                 String    @map("user_id") @db.Uuid
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken            String?   @map("access_token") @db.Text
  refreshToken           String?   @map("refresh_token") @db.Text
  idToken                String?   @map("id_token") @db.Text
  accessTokenExpiresAt   DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at")
  scope                 String?   @db.Text
  password               String?   @db.Text
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model Subscription {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  stripeCustomerId  String?  @map("stripe_customer_id") @db.VarChar(255)
  stripeSubId       String?  @map("stripe_sub_id") @db.VarChar(255)
  quantity          Int      @default(1)
  status            String   @default("active") @db.VarChar(20) // active, past_due, canceled, trialing
  currentPeriodEnd  DateTime? @map("current_period_end")
  canceledAt        DateTime? @map("canceled_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}
