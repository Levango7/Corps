  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同一用户在同一任务中只保留一条在线状态
  @@unique([taskId, userId])
  // 按任务查询在线成员列表
  @@index([taskId])
  @@map("chat_presences")
}

