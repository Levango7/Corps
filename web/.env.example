# ─── 数据库（本地 Docker：web/docker-compose.yml）────────────────────
# OWNER 连接：仅用于 prisma db push / migrate（表主，绕过 RLS）
DATABASE_URL="postgresql://postgres:changeme-dev-only@localhost:5432/corps?schema=public"
# RUNTIME 连接（可选，RLS 加固验证用）：非表主角色 corps_app，密码在应用 db/schema.sql 时设置
# DATABASE_URL="postgresql://corps_app:<CORPS_APP_PASSWORD>@localhost:5432/corps?schema=public"

# ─── 认证密钥（生产必须换为强随机值，如 openssl rand -hex 32）─────────
JWT_ACCESS_SECRET="replace-with-secure-random-string"
JWT_REFRESH_SECRET="replace-with-secure-random-string"
BETTER_AUTH_SECRET="replace-with-secure-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe（未配置时计费页自动隐藏升级入口）───────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# ─── DeepSeek AI（未配置时 AI 功能返回 503）──────────────────────────
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
# ─── LiveKit 音视频（未配置时会议功能不可用）──────────────────────────
# LIVEKIT_URL：WebSocket 接入地址（wss:// 或 ws://），前端用于连接 LiveKit 房间
# LIVEKIT_API_KEY / LIVEKIT_API_SECRET：服务端签发 MeetingToken 的密钥对，
#   需与 livekit.yaml 中 keys 配置一致（key: secret 映射）
# LIVEKIT_TOKEN_TTL：签发的 MeetingToken 有效期（秒），默认 2 小时
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_TOKEN_TTL="7200"

# ─── S3 对象存储（IM 附件 / 录制文件持久化）──────────────────────────
# 未配置时附件回退到本地 uploads/ 卷；配置后上传到 S3 兼容存储（MinIO/R2/AWS）
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="corps-uploads"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# ─── 可观测性 / 错误上报（可选；均未配置时仅输出本地结构化日志）─────────
# 实现说明：错误上报为**零依赖**实现（见 lib/observability.ts），无需安装任何 SDK。
#   · 本地日志始终生效（lib/logger.ts，生产为 JSON，可被 ELK/Loki/Datadog 采集）
#   · 下列任一项配置后额外启用远端上报，两项可同时启用
#   · 防风暴：每个 sink 每分钟最多上报 30 条，超出丢弃
#   · 脱敏：password/token/secret/authorization/cookie 等键自动替换为 [REDACTED]

# Sentry（服务端）：形如 https://<publicKey>@o<org>.ingest.sentry.io/<projectId>
# 走 Sentry 公开的 Envelope HTTP API 直传，不使用 @sentry/nextjs SDK。
SENTRY_DSN=""

# Sentry（浏览器端，可选）：前端需用 NEXT_PUBLIC_ 前缀才会注入客户端产物。
# Sentry 的 public key 设计上可安全暴露于浏览器。
NEXT_PUBLIC_SENTRY_DSN=""

# 上报环境标识（未配置时回退 NODE_ENV）
SENTRY_ENVIRONMENT=""
# 发布版本标识，建议填 git sha 或 semver（便于在 Sentry 按版本聚合/回归比对）
SENTRY_RELEASE=""

# 告警 webhook（可选）：POST JSON，兼容飞书/企业微信/Slack 自定义机器人。
# body 形如 { text, level, name, message, stack, tags, extra, timestamp }
ERROR_WEBHOOK_URL=""

# 日志级别：debug | info | warn | error | fatal（默认 info）
LOG_LEVEL="info"