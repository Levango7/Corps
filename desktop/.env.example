# =============================================================================
# Corps 桌面端环境变量模板
# 用法：cp .env.example .env，然后填入真实值
# 生成强随机密钥：openssl rand -hex 32
#
# 桌面端在运行时内嵌 Next.js standalone server（Sidecar 子进程），
# 以下变量由该 server 读取，用于连接后端数据库、认证、AI、实时通信和存储服务。
# =============================================================================

# ─── Next.js Standalone Server ───────────────────────────────────────────────
# standalone server 监听端口；Tauri WebView 默认加载 http://127.0.0.1:3000
PORT=3000
# 绑定地址；桌面端仅本地访问，固定 127.0.0.1，切勿改为 0.0.0.0（会暴露到局域网）
HOSTNAME=127.0.0.1
# 运行模式；桌面端固定 production
NODE_ENV=production

# ─── PostgreSQL 数据库 ──────────────────────────────────────────────────────
# 应用数据库连接 URL；桌面端需指向用户可访问的 PostgreSQL 实例
# 本地开发：postgresql://postgres:password@localhost:5432/corps
# 远程数据库：postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/corps

# ─── 认证密钥（必填，生产必须换为强随机值）─────────────────────────────────
# Better Auth 会话签名密钥
# 生成命令：openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-secure-random-string-32-hex

# ─── AI 服务（可选，未配置时 AI 功能降级）──────────────────────────────────
# AI 服务 API 密钥（如 OpenAI / 兼容接口）
# 未配置时 AI 相关功能不可用，其余功能正常运行
AI_API_KEY=

# ─── LiveKit 实时音视频（可选，未配置时会议功能不可用）─────────────────────
# LiveKit Server 接入地址（WebSocket 协议，ws:// 或 wss://）
# 本地开发：ws://localhost:7880
LIVEKIT_URL=
# LiveKit API 密钥（与 livekit.yaml 的 keys 配置一致）
LIVEKIT_API_KEY=
# LiveKit API 密钥（HMAC-SHA256 签名用，与 livekit.yaml 的 keys 值一致）
LIVEKIT_API_SECRET=
# Token 有效期（秒），默认 7200（2 小时）
LIVEKIT_TOKEN_TTL=7200
# 端到端加密开关（默认关闭）；启用后客户端需注入 E2EE 密钥
LIVEKIT_E2EE_ENABLED=false

# ─── S3 兼容存储（可选，用于录制文件上传）──────────────────────────────────
# S3 兼容存储端点（如 MinIO / AWS S3 / 阿里云 OSS）
# 本地 MinIO：http://localhost:9000
S3_ENDPOINT=
# 存储桶名
S3_BUCKET=
# 访问密钥
S3_ACCESS_KEY=
# 密钥
S3_SECRET_KEY=
# 区域
S3_REGION=us-east-1

# ─── 应用 URL（可选）────────────────────────────────────────────────────────
# 桌面端默认 http://localhost:3000；如需修改端口需同步修改 PORT
NEXT_PUBLIC_APP_URL=http://localhost:3000