{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corps",
  "version": "0.6.0",
  "identifier": "com.corps.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "cd ../web && pnpm dev",
    "beforeBuildCommand": "cd ../web && pnpm build && node ../desktop/copy-standalone.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Corps",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:*; media-src 'self' blob: mediastream:; worker-src 'self' blob:; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/standalone/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://releases.corps.com/desktop/updater/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_YOUR_UPDATER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    },
    "autostart": {
      "macos": {
        "args": ["--autostart"]
      }
    }
  }
}