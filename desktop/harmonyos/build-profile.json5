{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "arkEnabled": true
        }
      }
    ],
    "buildModeParam": {
      "debug": {
        "debuggable": true
      },
      "release": {
        "debuggable": false
      }
    }
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"]
        }
      ]
    }
  ]
}