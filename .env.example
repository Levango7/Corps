# =============================================================================
# Corps 部署环境变量模板
# 用法：cp .env.example .env，然后填入真实值
# 生成强随机密钥：openssl rand -hex 32
# =============================================================================

# ─── PostgreSQL 数据库 ──────────────────────────────────────────────────────
# 安全提示：历史上此模板曾包含真实密码并进入版本库（已登记 docs/runbook-deploy.md），
# 所有环境必须使用全新轮换的强密码：openssl rand -hex 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-openssl-rand-hex-16
POSTGRES_DB=corps

# ─── 应用数据库连接 URL ─────────────────────────────────────────────────────
# 注意：docker-compose 中 app 容器通过 service name 'db' 连接，host 为 db
# 本地直连时 host 为 localhost
DATABASE_URL=postgresql://postgres:change-me-openssl-rand-hex-16@db:5432/corps?schema=public

# ─── 认证密钥（生产必须换为强随机值）─────────────────────────────────────────
BETTER_AUTH_SECRET=replace-with-secure-random-string-32-hex
# docker-compose.yml 以 ${JWT_ACCESS_SECRET:?} 硬必填，缺失会让 compose 解析直接中止
JWT_ACCESS_SECRET=replace-with-secure-random-string-32-hex
# lib/env.ts 把 JWT_REFRESH_SECRET 列为必填（zod min(32)），缺失会在 instrumentation
# 阶段 process.exit(1)。2026-10-03 实测：它此前既不在 compose 也不在本文件，
# 任何干净环境的 `docker compose up -d` 都会启动失败（容器 Exit 1）。务必配置。
JWT_REFRESH_SECRET=replace-with-secure-random-string-32-hex

# ─── 宿主机端口（可选，默认 3000）───────────────────────────────────────────
# app 容器在宿主机上映射的端口。改它是为了避开本机已有服务占用的端口
# （例如 3000 常被其他容器占着，报错与 corps 无关、很难定位）。
# 生产走反向代理时同样建议显式指定。
APP_PORT=3000

# ─── 应用 URL ───────────────────────────────────────────────────────────────
# 生产环境改为实际域名，如 https://corps.example.com
# Stripe Customer Portal return_url 依赖此变量构造绝对地址；未配置时退化为相对路径
# （Stripe 校验可能拒绝相对地址），生产环境必配
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Stripe（可选，未配置时计费页隐藏升级入口）──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 缺省档价格 ID（月付）；自 ADR-003 §6 起冻结，调整需重新评审
STRIPE_PRICE_ID=
# 年付档价格 ID（可选）；未配置时 checkout 收到 period=yearly 返回 400「年付价格未配置」，绝不静默降级
STRIPE_PRICE_ID_YEARLY=

# ─── 支付通道选择（PaymentProvider 抽象，ADR-003 §5）─────────────────────────
# Phase 1 仅 stripe 有实现；wechatpay-native / alipay-page 为 Phase 2 预留
PAYMENT_PROVIDER=stripe

# ─── 微信支付 Native 直连（Phase 2，ADR-003 §4）─────────────────────────────
# 前置条件：企业营业执照 + 对公银行账户 + 法人证件 + ICP 备案域名
# 未配置时 WeChatPayNativeProvider.isConfigured=false，前端隐藏微信支付入口
# 沙箱环境：https://pay.weixin.qq.com/index.php/core/home/login
WECHAT_APP_ID=
WECHAT_MCH_ID=
# APIv3 密钥（32 字节字符串），用于 HMAC-SHA256 签名与 AES-256-GCM 回调解密
# 生成命令：openssl rand -hex 16（需在微信商户平台设置相同的 APIv3 密钥）
WECHAT_API_KEY=
# 商户证书序列号（在微信商户平台获取）
WECHAT_CERT_SERIAL_NO=
# 月付单价（单位：分），缺省 2990 = ¥29.9（pricing-redesign-v2 拍板价）
WECHAT_PRICE_CENTS_MONTHLY=2990
# 年付单价（单位：分），缺省 29900 = ¥299（pricing-redesign-v2，付 10 个月用 12 个月）
WECHAT_PRICE_CENTS_YEARLY=29900
# 异步回调地址；缺省由 NEXT_PUBLIC_APP_URL 拼接 /api/v1/billing/webhook/wechat
WECHAT_NOTIFY_URL=
# API 网关地址；沙箱可覆盖（缺省正式环境 https://api.mch.weixin.qq.com）
WECHAT_API_BASE=

# ─── 支付宝电脑网站支付直连（Phase 2，ADR-003 §4）──────────────────────────
# 前置条件：企业支付宝 + 营业执照 + 对公验证 + ICP 备案网站
# 未配置时 AlipayPageProvider.isConfigured=false，前端隐藏支付宝入口
# 沙箱环境：https://openhome.alipay.com/develop/sandbox/app
ALIPAY_APP_ID=
# 应用私钥（RSA2，纯 base64 或 PEM 格式）；在支付宝开放平台生成并上传公钥
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（RSA2，纯 base64 或 PEM 格式）；用于回调验签
ALIPAY_PUBLIC_KEY=
# 月付单价（单位：分），缺省 2990 = ¥29.9（pricing-redesign-v2 拍板价）
ALIPAY_PRICE_CENTS_MONTHLY=2990
# 年付单价（单位：分），缺省 29900 = ¥299（pricing-redesign-v2）
ALIPAY_PRICE_CENTS_YEARLY=29900
# 异步回调地址；缺省由 NEXT_PUBLIC_APP_URL 拼接 /api/v1/billing/webhook/alipay
ALIPAY_NOTIFY_URL=
# 网关地址；沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=

# ─── 邮件服务（可选，Resend）─────────────────────────────────────────────────
# EMAIL_FROM 为 Resend 发件人地址（需为已验证域名），如 corpsteam@example.com
RESEND_API_KEY=
EMAIL_FROM=
# 邮箱验证开关（2026-10-08）：=1 时注册不发会话凭据，需点击验证邮件链接后才能登录
#（防抢注受邀邮箱的社会工程面）。**开启前务必先配置 Resend**——邮件发不出去会
# 把新用户锁死在验证页。代码默认关（flag 缺省）；生产模板 deploy/.env.prod.example
# 已置 1。CI/本地测试保持缺省（integration 用例按"不发验证"路径断言）。
REQUIRE_EMAIL_VERIFICATION=

# ─── 定时作业鉴权（可选）────────────────────────────────────────────────────
# 截止日提醒 /api/cron/due-reminders 的 Bearer 鉴权密钥（未配置时端点返回 500）。
# compose 编排的 cron 容器会定时调用（due-reminders 每日、cleanup-uploads 每周一）；
# 生成命令：openssl rand -hex 16
CRON_SECRET=

# ─── cron 调度时区（可选）───────────────────────────────────────────────────
# cron 容器的计划表时区，默认 UTC（即北京时间 +8）。北京时间调度填 Asia/Shanghai。
# 例：UTC 下每日 01:00 = 北京时间 09:00；Asia/Shanghai 下每日 01:00 = 北京时间凌晨 01:00。
CRON_TZ=UTC

# ─── RLS 运行时角色密码（RLS_ACTIVATE=true 时必填）─────────────────────────
# 与 db/rls-activate.sql 创建的 corps_app 角色密码一致；应用运行时以此角色连接，
# 受 FORCE ROW LEVEL SECURITY 约束。生成命令：openssl rand -hex 16
# 留空会让 docker-compose 的 ${CORPS_APP_PASSWORD:?} 在解析阶段直接中止，故给占位值。
CORPS_APP_PASSWORD=change-me-openssl-rand-hex-16

# ─── 日志级别（可选）────────────────────────────────────────────────────────
# debug/info/warn/error/fatal，默认 info。生产建议 info 或 warn。
LOG_LEVEL=info

# ─── Prometheus 指标端点令牌（可选）─────────────────────────────────────────
# 设置后 /api/metrics 要求 Authorization: Bearer <token>（Prometheus scrape 端
# 配 authorization.credentials，见 docs/runbook-deploy.md §8.2）；不设置则端点
# 开放，由网络层（防火墙/ingress）限制访问。生成命令：openssl rand -hex 16
METRICS_TOKEN=

# ─── RLS 加固开关（默认 true）──────────────────────────────────────────────
# 容器启动时自动执行 migrate deploy + rls-activate.sql；置 false 退回非加固模式（不推荐）
RLS_ACTIVATE=true

# ─── 统一写策略开关（默认 enforce）──────────────────────────────────────────
# 写请求（POST/PUT/PATCH/DELETE）经 lib/auth.ts 的 getWorkspaceContext 做 default-deny 裁决：
#   enforce  默认。viewer 写工作区数据一律拒绝；自助类端点（自己的收藏/通知/设备/资料）放行。
#   shadow   只记日志不拦截，用于上线前观察误杀面（日志关键字 `[write-policy] shadow-deny`）。
#   off      完全关闭（不推荐，等于回到"只有角色声明没有执行"）。
# 取值非法（含拼错）一律按 enforce 处理：env 拼错不能成为绕过安全性的方式。
WRITE_POLICY_MODE=enforce

# ─── Redis（限流共享计数，TC-RATE-05）──────────────────────────────────────
# web/lib/rate-limit.ts 检测到 REDIS_URL 后启用 Redis 固定窗口原子计数（INCR+PEXPIRE）。
# 单实例部署可不配置（自动使用进程内内存限流）；
# 多实例 / Serverless 水平扩容部署必须配置共享 Redis，否则各实例独立计数、限流配额被稀释。
# docker-compose 已内置 redis 服务并默认注入 redis://redis:6379（compose 内网地址），
# 本地直连或外部 Redis 时改为本机/实际地址：
REDIS_URL=redis://localhost:6379

# ─── 日历集成（calendar-integration）────────────────────────────────────────
# Google Calendar OAuth2：在 Google Cloud Console 创建 OAuth 2.0 客户端凭据
# （https://console.cloud.google.com/apis/credentials），授权回调 URL 填：
#   {NEXT_PUBLIC_APP_URL}/api/v1/auth/calendar/google/callback
# scope: https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Outlook Calendar OAuth2：在 Azure Portal 注册应用
# （https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps），授权回调 URL 填：
#   {NEXT_PUBLIC_APP_URL}/api/v1/auth/calendar/outlook/callback
# scope: Calendars.ReadWrite offline_access
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=

# 日历 OAuth token 加密主密钥（AES-256-GCM，32 字节）
# 生成命令：openssl rand -hex 32
# 未配置时开发环境回退到固定测试密钥；生产环境必须配置
CALENDAR_CRYPTO_KEY=

# 日历 OAuth state 签名密钥（HMAC-SHA256，防 CSRF）
# 未配置时回退到 JWT_ACCESS_SECRET；生产环境建议独立配置
CALENDAR_STATE_SECRET=
# ─── LiveKit 音视频（会议/通话）─────────────────────────────────────────────
# LiveKit Server 接入配置；未配置时会议功能返回 503
# API_KEY/API_SECRET 需与 livekit.yaml 中的 keys 一致
# 开发默认 devkey/secret（生产必须替换为强随机值）
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# LiveKit Server 接入地址（容器内通过 service name 解析）
LIVEKIT_URL=ws://livekit:7880
# Token 有效期（秒），默认 3600 = 1 小时
LIVEKIT_TOKEN_TTL=3600
# E2EE 端到端加密开关（默认 false；启用后客户端需注入 E2EE 密钥）
LIVEKIT_E2EE_ENABLED=false

# ─── Web Push 推送（P1 PWA 化，可选）──────────────────────────────────────────
# VAPID 密钥对用于 Web Push 协议鉴权。生成命令：
#   npx web-push generate-vapid-keys
# 未配置时推送功能不可用（降级为空字符串），但应用其余功能正常运行
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 推送主体标识（mailto: 或 https: URL），默认 mailto:admin@corps.app
VAPID_SUBJECT=mailto:admin@corps.app

# ─── 文档实时协同（可选，留空即「本地编辑 + 版本历史」模式）────────────────────
# 协同服务端（server/collab/）当前未随 compose 部署，且尚未实现令牌鉴权——
# 在鉴权补齐前直接启用会形成跨租户文档读写面。故当前默认走本地编辑模式：
# 文档仍正常保存到 documents.markdown，版本历史照常记录，只是没有多人在线协同。
# 详见 docs/decisions/ADR-012-文档协同降级为本地编辑模式.md
# 未来收编并补齐鉴权后，在此填写 WebSocket 地址即可启用，前端无需改动。
NEXT_PUBLIC_COLLAB_WS_URL=
