# ===========================================================================
# corps 反向代理配置（Nginx）
#
# 与 Caddyfile.example 等价，供已有 Nginx 的部署环境使用。
# HTTPS 为硬性要求，原因见 Caddyfile.example 顶部说明（会话 cookie 带 Secure）。
#
# 证书：推荐 certbot（`certbot --nginx -d corps.example.com`）自动配置与续期。
# 若用国内服务器，需先完成 ICP 备案。
# ===========================================================================

# HTTP 全量跳转到 HTTPS（certbot 会保留 /.well-known 校验路径）
server {
    listen 80;
    listen [::]:80;
    server_name corps.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name corps.example.com;

    ssl_certificate     /etc/letsencrypt/live/corps.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/corps.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # 上传体积：Free 10MB / Pro 50MB，留余量
    client_max_body_size 60m;

    # 应用自身已注入 CSP / HSTS（web/middleware.ts），此处不重复
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 反代目标：compose 网络内用 app:3000；宿主机用 127.0.0.1:3001（对齐 APP_PORT）
    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;

        # WebSocket 升级（LiveKit 信令、协同 WS 未来收编时使用）
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # 真实客户端 IP：限流与 share_access_logs 依赖，缺失会把所有请求记成同一 IP
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE（IM 实时消息）需关闭缓冲，否则消息会被攒着一起发
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
